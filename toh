    local obj=ch[STEP_INDEX]
    local fallback=false
    if not obj then obj=ch[#ch] fallback=true notify("Step ke-"..STEP_INDEX.." ga ada, pakai step terakhir") end
    if not obj then return nil end
    local mn,mx=boundsOf(obj)
    if not mn then return nil end
    local pos=Vector3.new((mn.X+mx.X)/2,mx.Y+3,(mn.Z+mx.Z)/2)
    local ext=math.clamp(math.min(mx.X-mn.X,mx.Z-mn.Z)/2-1,3,12)
