------------------------------------------------------------ GEOMETRY HELPERS
local function partsOf(inst)
    local t={}
    if not inst then return t end
    if inst:IsA("BasePart") then t[1]=inst end
    for _,d in ipairs(inst:GetDescendants()) do if d:IsA("BasePart") then t[#t+1]=d end end
    return t
end
local function boundsOf(inst)
    local mn,mx
    for _,p in ipairs(partsOf(inst)) do
        local cf,s=p.CFrame,p.Size
        local r,u,l=cf.RightVector,cf.UpVector,cf.LookVector
        local ex=(math.abs(r.X)*s.X+math.abs(u.X)*s.Y+math.abs(l.X)*s.Z)/2
        local ey=(math.abs(r.Y)*s.X+math.abs(u.Y)*s.Y+math.abs(l.Y)*s.Z)/2
        local ez=(math.abs(r.Z)*s.X+math.abs(u.Z)*s.Y+math.abs(l.Z)*s.Z)/2
        local a=cf.Position-Vector3.new(ex,ey,ez)
        local b=cf.Position+Vector3.new(ex,ey,ez)
        if not mn then mn,mx=a,b else
            mn=Vector3.new(math.min(mn.X,a.X),math.min(mn.Y,a.Y),math.min(mn.Z,a.Z))
            mx=Vector3.new(math.max(mx.X,b.X),math.max(mx.Y,b.Y),math.max(mx.Z,b.Z))
        end
    end
    return mn,mx
end
local function posOf(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local mn,mx=boundsOf(inst)
    if mn then return (mn+mx)/2 end
end
local function standPos(part)
    if part and part:IsA("BasePart") then
        return part.Position+Vector3.new(0,math.min(part.Size.Y/2,8)+3,0)
    end
    local p=posOf(part) or Vector3.zero
    return p+Vector3.new(0,3,0)
end
local function segDist(p,a,b)
    local ab=b-a
    local l2=ab:Dot(ab)
    if l2<1e-6 then return (p-a).Magnitude end
    local t=math.clamp((p-a):Dot(ab)/l2,0,1)
    return (p-(a+ab*t)).Magnitude
end
------------------------------------------------------------ SECTIONS
local function towerFolder() return Workspace:FindFirstChild("tower") end
local function sectionsFolder() local t=towerFolder() return t and t:FindFirstChild("sections") end
local function numVal(i)
    if i and i:IsA("ValueBase") and type(i.Value)=="number" then return i.Value end
end
local secCache,secT={},0
local function getSections(force)
    if not force and os.clock()-secT<1 then return secCache end
    local list={}
    local f=sectionsFolder()
    if f then
        for _,s in ipairs(f:GetChildren()) do
            local nm=s.Name:lower()
            if nm~="lobby" and nm~="finish" then
                local a,b=s:FindFirstChild("start"),s:FindFirstChild("stop")
                local pa=posOf(a)
                if a and b and pa then
                    list[#list+1]={inst=s,start=a,stop=b,center=s:FindFirstChild("center"),
                        i=numVal(s:FindFirstChild("i")),y=pa.Y}
                end
            end
        end
    end
    local useI=false
    if cfg.orderMode~=3 and #list>0 then
        useI=true
        local seen={}
        for _,s in ipairs(list) do
            if not s.i then useI=false break end
            if cfg.orderMode==1 and seen[s.i] then useI=false break end
            seen[s.i]=true
        end
    end
    if useI then table.sort(list,function(x,y) return x.i<y.i end)
    else table.sort(list,function(x,y) return x.y<y.y end) end
    secCache,secT=list,os.clock()
    return list
end
local function currentIndex()
    local r=hrp()
    local list=getSections()
    if not r or #list==0 then return nil,math.huge end
    local best,bd
    for i,s in ipairs(list) do
        local d=segDist(r.Position,posOf(s.start),posOf(s.stop))
        if not bd or d<bd then best,bd=i,d end
    end
    if autoEnabled and st.progress>0 then
        local sp=math.clamp(st.progress,1,#list)
        local d=segDist(r.Position,posOf(list[sp].start),posOf(list[sp].stop))
        if d-bd<=12 then return sp,d end
    end
    return best,bd
end
