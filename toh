local flightId=0
local flying=false
local flyNoclip=false
local noclipParts={}
local function applyNoclip()
    local c=char()
    if not c then return end
    for _,p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then noclipParts[p]=true p.CanCollide=false end
    end
end
local function restoreCollide()
    for p in pairs(noclipParts) do if p.Parent then p.CanCollide=true end end
    noclipParts={}
end
local function cancelFlight()
    flightId+=1
    flying=false
    restoreCollide()
end
addConn(RunService.Stepped:Connect(function()
    if flying and flyNoclip and cfg.noclip then applyNoclip() end
end))
local function placeAt(pos)
    local r=hrp()
    if not r then return false end
    r.CFrame=CFrame.new(pos)*(r.CFrame-r.CFrame.Position)
    r.AssemblyLinearVelocity=Vector3.zero
    r.AssemblyAngularVelocity=Vector3.zero
    return true
end
local function instantTo(pos) cancelFlight() return placeAt(pos) end
local function flyTo(pos,speed,nc)
    local root=hrp()
    if not root then return false end
    cancelFlight()
    flightId+=1
    local id=flightId
    flying=true
    flyNoclip=nc and cfg.noclip
    if flyNoclip then applyNoclip() end
    speed=math.max(speed or 60,1)
    local timeout=os.clock()+(root.Position-pos).Magnitude/speed+6
    local lastD=(root.Position-pos).Magnitude
    local lastT=os.clock()
    local ok=true
    while true do
        local dt=RunService.Heartbeat:Wait()
        if id~=flightId then return false end
        local r=hrp()
        if not r or r~=root or not r.Parent then ok=false break end
        local cur=r.Position
        local diff=pos-cur
        local d=diff.Magnitude
        if d<=1.5 then break end
        if os.clock()>timeout then break end
        if os.clock()-lastT>=2 then
            if lastD-d<1 then break end
            lastD,lastT=d,os.clock()
        end
        local np=cur+diff.Unit*math.min(d,speed*dt)
        r.CFrame=CFrame.new(np)*(r.CFrame-r.CFrame.Position)
        r.AssemblyLinearVelocity=Vector3.zero
        r.AssemblyAngularVelocity=Vector3.zero
    end
    if id~=flightId then return false end
    if ok then placeAt(pos) end
    flying=false
    restoreCollide()
    return ok
end
local function goTo(pos,fly,speed,nc)
    if fly then return flyTo(pos,speed,nc) end
    return instantTo(pos)
end
