env.__STP_Unload=function()
    unloaded=true
    autoEnabled=false
    runId+=1
    pcall(cancelFlight)
    pcall(setAnti,false)
    for _,c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() if gui then gui:Destroy() end end)
    env.__STP_Unload=nil
end
