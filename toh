local function getFinishTarget()
    local pad=getFinishPad()
    if not pad then return nil end
    local mn,mx=boundsOf(pad)
    if not mn then return nil end
    return Vector3.new((mn.X+mx.X)/2,mx.Y+3,(mn.Z+mx.Z)/2)
end
local function glowTarget(g,mid)
    local mn,mx=boundsOf(g)
    if not mn then return nil end
    local c=(mn+mx)/2
    if mid then return c end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={char() or Workspace,g}
    local hit=Workspace:Raycast(Vector3.new(c.X,mx.Y,c.Z),Vector3.new(0,-300,0),params)
    local y=hit and hit.Position.Y+3 or c.Y
    y=math.clamp(y,mn.Y+1,math.max(mn.Y+1,mx.Y-1))
    return Vector3.new(c.X,y,c.Z)
end
local function inFinishZone()
    local r=hrp()
    if not r then return false end
    local p=r.Position
    local function inside(inst,px,py)
        if not inst then return false end
        local mn,mx=boundsOf(inst)
        if not mn then return false end
        return p.X>=mn.X-px and p.X<=mx.X+px and p.Z>=mn.Z-px and p.Z<=mx.Z+px
            and p.Y>=mn.Y-py and p.Y<=mx.Y+py
    end
    return inside(getGlow(),1,1) or inside(getFinishPad(),2,6)
end
local function lobbyPos()
