local function waitLive(id,t,label)
    local e=os.clock()+t
    while os.clock()<e do
        if not alive(id) then return false end
        setStatus(("%s %ds"):format(label,math.ceil(e-os.clock())))
        task.wait(0.1)
    end
    return alive(id)
end
local function waitChar(id)
    local t=os.clock()+15
    while alive(id) and os.clock()<t do
        local h,r=hum(),hrp()
        if h and r and h.Health>0 then task.wait(0.5) return true end
        task.wait(0.2)
    end
    return false
end
local function walkAround(id,center,ext)
    local mn,mxv=cfg.topWalkMin,math.max(cfg.topWalkMax,cfg.topWalkMin)
    local t1=os.clock()+mn+math.random()*(mxv-mn)
    while os.clock()<t1 do
        if not alive(id) then return end
        local h,r=hum(),hrp()
        if not h or not r or h.Health<=0 then return end
        setStatus(("WALK TOP %.0fs"):format(math.max(0,t1-os.clock())))
        local flat=Vector3.new(r.Position.X-center.X,0,r.Position.Z-center.Z).Magnitude
        if flat>ext+6 or r.Position.Y<center.Y-6 then placeAt(center) end
        local ang,rad=math.random()*math.pi*2,math.random()*ext
        h:MoveTo(Vector3.new(center.X+math.cos(ang)*rad,r.Position.Y,center.Z+math.sin(ang)*rad))
        if math.random()<0.3 then h.Jump=true end
        local w=os.clock()+0.8+math.random()*0.8
        while os.clock()<w and os.clock()<t1 and alive(id) do task.wait(0.1) end
    end
    local h,r=hum(),hrp()
    if h and r then h:MoveTo(r.Position) end
end
local function touchGlow(id)
    for attempt=1,2 do
        local g=getGlow()
        if not g then notify("FinishGlow ga ketemu") return false end
        local t0=os.clock()
        local pos=glowTarget(g,attempt==2)
        if not pos then return false end
        setStatus("TOUCH GLOW"..(attempt==2 and " (2)" or ""))
        local ok=goTo(pos,cfg.glowMove==2,cfg.autoSpeed,true)
        if not alive(id) or not ok then return false end
        local hold=os.clock()+cfg.finishHold
        while os.clock()<hold do
            if not alive(id) then return false end
            local r=hrp()
            if not r then return false end
            if (r.Position-pos).Magnitude>6 then placeAt(pos) end
            task.wait(0.1)
        end
        if st.touchAt>=t0 or inFinishZone() then return true end
    end
    return false
end
local function padRun(id)
    if not getFinishPad() then notify("Finish pad ga ketemu") return false end
    for _=1,2 do
        local t0=os.clock()
        local pos=getFinishTarget()
        if not pos then return false end
        setStatus("TO FINISH PAD")
        local ok=flyTo(pos,cfg.autoSpeed,true)
        if not alive(id) or not ok then return false end
        local hold=os.clock()+cfg.finishHold
        while os.clock()<hold do
            if not alive(id) then return false end
            local r=hrp()
            if not r then return false end
            local flat=Vector3.new(r.Position.X-pos.X,0,r.Position.Z-pos.Z).Magnitude
            if flat>8 or r.Position.Y<pos.Y-8 then placeAt(pos) end
            task.wait(0.1)
        end
        if st.touchAt>=t0 then return true end
    end
    return false
end
local function skipRoundFlow(id)
    if not waitLive(id,cfg.skipDelay,"SKIP ROUND IN") then return false end
    for attempt=1,2 do
        setStatus("PRESS SKIP ROUND"..(attempt==2 and " (2)" or ""))
        local pressed=pressSkipRound()
        if not pressed then return false end
        local e=os.clock()+6
        while os.clock()<e do
            if not alive(id) then return false end
            if st.fSnap and not towerAlive(st.fSnap) then return true end
            setStatus(("WAIT SKIP %ds"):format(math.ceil(e-os.clock())))
            task.wait(0.2)
        end
    end
    return false
end
local function completeRoundInner(id)
    if not hum() or not hrp() then return nil end
    local pos,ext=getStepsTarget()
    if pos then
        setStatus("TO FINISH STEPS")
        local ok=goTo(pos,cfg.stepsMove==2,cfg.autoSpeed,true)
        if not alive(id) then return nil end
        local h=hum()
        if not ok or not h or h.Health<=0 then st.needResume=true return nil end
        walkAround(id,pos,ext)
        if not alive(id) then return nil end
    else
        notify("Finish steps ga ketemu, lanjut ke finish")
    end
    local orders={{"glow"},{"pad"},{"glow","pad"},{"pad","glow"}}
    local touched=false
    for _,m in ipairs(orders[cfg.finishMode] or orders[1]) do
        local ok=(m=="glow") and touchGlow(id) or (m=="pad" and padRun(id))
        if not alive(id) then return nil end
        local h=hum()
        if not h or h.Health<=0 then st.needResume=true return nil end
        if ok then touched=true break end
    end
    if touched then notify("Finish kesentuh")
    else notify("Finish belum kedeteksi kesentuh, round tetap dianggap selesai") end
    if cfg.autoSkip and touched then
        markFinished("round")
        skipRoundFlow(id)
        if not alive(id) then return nil end
    else
        if cfg.autoSkip and not touched then notify("Skip Round dibatalin: finish belum kesentuh") end
        if cfg.finishReturn and pos then
            setStatus("RETURN")
            goTo(pos,cfg.stepsMove==2,cfg.autoSpeed,true)
        end
        markFinished("round")
    end
    return "done"
end
local function completeRound(id)
    st.inComplete=true
    local ok,res=pcall(completeRoundInner,id)
    st.inComplete=false
    if not alive(id) then return end
    if not ok then warn("[STP] "..tostring(res)) notify("Error finish: "..tostring(res)) task.wait(2) return end
    if res=="done" then
        if cfg.autoOffWhenDone then
            notify("Selesai, Autonomous OFF")
            setAuto(false)
        else
            st.roundDone=true
            setStatus("WAITING FOR NEW ROUND")
            notify("Selesai, nunggu round baru")
        end
    end
end
local function autoCycle(id)
    local list=getSections(true)
    if st.roundDone then
        setStatus("WAITING FOR NEW ROUND")
        if st.fSnap and towerAlive(st.fSnap) then task.wait(0.5) return end
        if #list==0 then task.wait(0.5) return end
        st.roundDone=false st.finished=false st.progress=0 st.deaths={} st.rSnap=nil st.needInit=false
        notify("Round baru kedeteksi")
        waitLive(id,cfg.newRoundDelay,"NEW ROUND IN")
        return
    end
    if st.finished and towerAlive(st.fSnap) then st.roundDone=true return end
    if #list==0 then setStatus("NO TOWER") task.wait(1) return end
    local h,r=hum(),hrp()
    if not h or not r or h.Health<=0 then setStatus("WAIT CHARACTER") waitChar(id) return end
    if not st.rSnap then st.rSnap=snapshotTower()
    elseif not towerAlive(st.rSnap) then
        st.rSnap=snapshotTower() st.progress=0 st.needInit=false
        notify("Round baru, mulai dari stage 1")
    end
    if st.needInit then
        st.needInit=false
        local idx,d=currentIndex()
        if idx and d<=25 then st.progress=math.max(0,idx-1) end
    end
    local total=#list
    if st.progress>total then st.progress=total end
    local n=st.progress+1
    if n>total then
        setStatus("FINISH SEQUENCE")
        completeRound(id)
        return
    end
    local sec=list[n]
    local part=(cfg.autoTarget==2) and sec.stop or sec.start
    setStatus(("CLIMB %d/%d"):format(n,total))
    local ok=goTo(standPos(part),cfg.autoMethod==1,cfg.autoSpeed,true)
    if not alive(id) then return end
    if not ok then
        if not cfg.resumeAfterDeath then st.progress=0 end
        st.needResume=true
        setStatus("RESPAWNED")
        waitChar(id)
        return
    end
    st.progress=n
    if n<total then
        local d=cfg.autoDelayMin+math.random()*math.max(0,cfg.autoDelayMax-cfg.autoDelayMin)
        waitLive(id,d,"NEXT STAGE IN")
    end
end
function autoLoop(id,delay)
    if delay and delay>0 then
        if not waitLive(id,delay,"RESYNC IN") then return end
    end
    if st.finished and towerAlive(st.fSnap) then
        st.roundDone=true
        notify("Udah finish, nunggu round baru")
    end
    while alive(id) do
        local ok,err=pcall(autoCycle,id)
        if not ok then warn("[STP] "..tostring(err)) task.wait(1) end
        task.wait(0.1)
    end
end
function resetRun(reason)
    runId+=1
    local id=runId
    st.deaths={} st.inComplete=false st.roundDone=false st.rSnap=nil
    st.needResume=false st.needInit=false st.progress=0
    cancelFlight()
    setStatus("RESYNC")
    notify("Desync Guard: restart dari stage 1 ("..reason..")")
    task.spawn(autoLoop,id,cfg.syncDelay)
end
function setAuto(on)
    if on==autoEnabled then return end
    autoEnabled=on
    runId+=1
    st.deaths={}
    if on then
        st.progress=0 st.needInit=true st.roundDone=false st.rSnap=nil st.needResume=false
        syncAnti()
        task.spawn(autoLoop,runId,0)
        notify("Autonomous ON")
    else
        cancelFlight()
        setStatus("IDLE")
        syncAnti()
        notify("Autonomous OFF")
    end
    refreshUI()
end
addConn(lp.CharacterAdded:Connect(function(c)
    if antiOn then task.spawn(applyGod,c) end
    if not autoEnabled then return end
    if not cfg.resumeAfterDeath then st.progress=0 end
    if not cfg.syncGuard then return end
    local now=os.clock()
    local fresh={}
    for _,t in ipairs(st.deaths) do if now-t<=cfg.syncWindow then fresh[#fresh+1]=t end end
    fresh[#fresh+1]=now
    st.deaths=fresh
    if #fresh>=cfg.syncDeaths then resetRun(("%d respawn / %ds"):format(#fresh,cfg.syncWindow)) end
end))
