    local function addStepper(sub,text,key,mn,mx,step,fmt,onCh)
        local f=baseRow(sub)
        rowLabel(f,text,SBS*2+46+16)
        local minus=smallBtn(f,"-",UDim2.new(1,-(SBS*2+46+10),0.5,-SBS/2))
        local val=mk("TextLabel",{Font=HEAD,TextSize=12,TextColor3=TXT,BackgroundTransparency=1,
            Size=UDim2.fromOffset(46,SBS),Position=UDim2.new(1,-(SBS+10+46),0.5,-SBS/2),Text=""},f)
        local plus=smallBtn(f,"+",UDim2.new(1,-(SBS+10),0.5,-SBS/2))
        addRef(function() val.Text=fmt and fmt(cfg[key]) or tostring(cfg[key]) end)
        local function bump(d)
            local v=cfg[key]+d*step
            v=math.max(mn,math.min(mx,v))
            cfg[key]=math.floor(v*100+0.5)/100
            if onCh then onCh() end
            saveCfg()
            refreshUI()
        end
        minus.MouseButton1Click:Connect(function() bump(-1) end)
        plus.MouseButton1Click:Connect(function() bump(1) end)
    end
