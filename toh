    addToggle(S,"Anti AFK",function() return cfg.antiAfk end,function(v) cfg.antiAfk=v end)
    addToggle(S,"Noclip While Flying",function() return cfg.noclip end,function(v) cfg.noclip=v end)
    addStepper(S,"Manual Fly Speed","flySpeed",20,300,10)
    addCycle(S,"Stage Order","orderMode",{"AUTO","INDEX (i)","HEIGHT"},function() getSections(true) end)
    -- SETTINGS / LOOK
    S=P3.subs[2]
    local accNames={}
    for i,a in ipairs(ACCENTS) do accNames[i]=a.n end
    addCycle(S,"Theme","accentIndex",accNames)
    addStepper(S,"Glass Transparency","transparency",0,0.8,0.05)
    addCycle(S,"UI Scale","uiScaleMode",UI_SCALE_NAMES,doRelayout)
    addCycle(S,"Layout","layoutMode",LAYOUT_NAMES,doRelayout)
    addCycle(S,"Float Button","floatBtn",FAB_NAMES,doRelayout)
    addToggle(S,"Notifications",function() return cfg.notifications end,function(v) cfg.notifications=v end)
    addCycle(S,"Menu Key","menuKey",MENU_KEYS)
    -- SETTINGS / CONFIG
    S=P3.subs[3]
    local function resetPositions()
        cfg.uiX,cfg.uiY=-1,-1
        cfg.fabX,cfg.fabY=-1,-1
        local vp=viewport()
        local s=uiScale.Scale
        local x,y=clampPos((vp.X-winW*s)/2,(vp.Y-winH*s)/2)
        root.Position=UDim2.fromOffset(x,y)
        local fx,fy=fabDefault()
        fab.Position=UDim2.fromOffset(fx,fy)
        saveCfg()
        notify("Posisi UI di-reset")
    end
    addButton(S,"Reset Settings",function()
        local keep={uiX=true,uiY=true,fabX=true,fabY=true}
        for k,v in pairs(DEFAULTS) do if not keep[k] then cfg[k]=v end end
        syncAnti()
        saveCfg()
        doRelayout()
        refreshUI()
        notify("Settings di-reset")
    end)
    addButton(S,"Reset UI Position",resetPositions)
    addButton(S,"Unload Script",function() if env.__STP_Unload then env.__STP_Unload() end end,true)
    ---------------------------------------------------- toast
    local toastHolder=mk("Frame",{Size=UDim2.fromOffset(340,200),AnchorPoint=Vector2.new(0.5,0),Position=UDim2.new(0.5,0,0,14),BackgroundTransparency=1},gui)
    local toastScale=mk("UIScale",{Scale=1},toastHolder)
    mk("UIListLayout",{Padding=UDim.new(0,5),HorizontalAlignment=Enum.HorizontalAlignment.Center,SortOrder=Enum.SortOrder.LayoutOrder},toastHolder)
    toastFn=function(text)
        local l=mk("Frame",{Size=UDim2.fromOffset(320,30),BackgroundColor3=Color3.fromRGB(14,17,36),BackgroundTransparency=0.05,BorderSizePixel=0},toastHolder)
        corner(l,15)
        local s=stroke(l,acc(),1,0.45)
        local dotf=mk("Frame",{Size=UDim2.fromOffset(6,6),Position=UDim2.fromOffset(13,12),BackgroundColor3=acc(),BorderSizePixel=0},l)
        corner(dotf,3)
        local t=mk("TextLabel",{Text=text,Font=BODY,TextSize=12,TextColor3=TXT,BackgroundTransparency=1,
            Position=UDim2.fromOffset(28,0),Size=UDim2.new(1,-38,1,0),TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd},l)
        task.delay(3,function()
            pcall(function()
                if not l.Parent then return end
                local ti=TweenInfo.new(0.3)
                TweenService:Create(l,ti,{BackgroundTransparency=1}):Play()
                TweenService:Create(t,ti,{TextTransparency=1}):Play()
                TweenService:Create(s,ti,{Transparency=1}):Play()
                TweenService:Create(dotf,ti,{BackgroundTransparency=1}):Play()
                task.wait(0.32)
                l:Destroy()
            end)
        end)
    end
    ---------------------------------------------------- relayout (auto scale + compact + clamp)
    relayout=function()
        compact=wantCompact()
        H=compact and H_COMPACT or H_FULL
        winW,winH=(minimized and MINI_W or W),(minimized and MINI_H or H)
        sidebar.Visible=not minimized
        content.Visible=not minimized
        divider.Visible=not minimized
        mini.Visible=minimized
        sidebar.Size=UDim2.fromOffset(SB,H)
        content.Size=UDim2.fromOffset(CW,H)
        divider.Size=UDim2.fromOffset(1,math.max(0,H-112))
        local scY=H-56-10-78
        statusHdr.Position=UDim2.fromOffset(24,scY-18)
        statusCard.Position=UDim2.fromOffset(12,scY)
        autoWrap.Position=UDim2.fromOffset(12,H-56)
        dash.Visible=not compact
        local sy=compact and (82+BARH+8) or SCROLL_Y
        for _,pg in ipairs(pages) do
            for _,s in ipairs(pg.subs) do
                s.frame.Position=UDim2.fromOffset(PAD,sy)
                s.frame.Size=UDim2.fromOffset(GW,math.max(40,H-sy-14))
            end
        end
        local sc=computeScale()
        uiScale.Scale=sc
        main.Size=UDim2.fromOffset(winW,winH)
        root.Size=UDim2.fromOffset(winW*sc,winH*sc)
        mainCorner.CornerRadius=UDim.new(0,minimized and math.floor(MINI_H/2) or 22)
        local x,y=clampPos(root.Position.X.Offset,root.Position.Y.Offset)
        root.Position=UDim2.fromOffset(x,y)
        local fx,fy=clampFab(fab.Position.X.Offset,fab.Position.Y.Offset)
        fab.Position=UDim2.fromOffset(fx,fy)
        toastScale.Scale=math.clamp((viewport().X-16)/340,0.5,1)
        updateFab()
    end
    gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() relayout() end)
    if cam then
        addConn(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() relayout() end))
    end
    ---------------------------------------------------- HUD loop
    local rng=Random.new()
    local function updateHUD()
        local a=acc()
        if not compact and not minimized then
            local list=getSections()
            local n=#list
            if barCount~=n then rebuildBars(n) end
            local idx=currentIndex()
            local cur=idx and list[idx]
            local nx=idx and list[idx+1]
            chipNow.Text="NOW  "..(cur and cur.inst.Name:upper() or "-")
            chipNext.Text="NEXT  "..(nx and nx.inst.Name:upper() or (idx and "FINISH" or "-"))
            for i,b in ipairs(bars) do
                b.BackgroundColor3=(idx and i<idx and a) or (idx==i and Color3.new(1,1,1)) or DIM
            end
            if idx and bars[idx] then
                marker.Visible=true
                marker.Position=UDim2.new((idx-0.5)/n,-1,1-barH[idx],-7)
            else
                marker.Visible=false
            end
            vStage.Text=(idx and idx or "-").."/"..n
            cStage.Text=cur and cur.inst.Name or "no stage"
            local frac=(idx and n>0) and idx/n or 0
            for k,b in ipairs(g1) do b.BackgroundColor3=(frac>0 and k/#g1<=frac+0.001) and a or DIM end
            vLeft.Text=idx and tostring(n-idx) or "-"
            cLeft.Text="to finish"
            local lit=(idx and n>0) and math.ceil(((n-idx)/n)*#g2) or 0
            for k,d in ipairs(g2) do d.BackgroundColor3=(k<=lit) and a or DIM end
            vAuto.Text=autoEnabled and "ON" or "OFF"
            vAuto.TextColor3=autoEnabled and a or SUB
            cAuto.Text=autoEnabled and (st.progress.."/"..n.." climbed") or "standby"
            for _,w in ipairs(g3) do
                local h=autoEnabled and (0.2+rng:NextNumber()*0.8) or 0.15
                w.BackgroundColor3=autoEnabled and a or DIM
                TweenService:Create(w,TweenInfo.new(0.25),{Size=UDim2.new(0,2,h,0)}):Play()
            end
            vAnti.Text="ON"
            vAnti.TextColor3=a
            cAnti.Text="protected"
            ringS.Color=a
            ringDot.BackgroundColor3=a
        end
        statusLbl.Text=statusText
        miniStatus.Text=statusText
        fabStroke.Color=autoEnabled and a or LINE
        fabDot.BackgroundColor3=autoEnabled and a or DIM
        local now,c=os.clock(),0
        for _,t in ipairs(st.deaths) do if now-t<=cfg.syncWindow then c+=1 end end
        if autoEnabled and cfg.syncGuard then
            guardChip.Text="RESETS "..c.."/"..cfg.syncDeaths
            guardChip.TextColor3=(c>0) and Color3.fromRGB(255,170,90) or a
        else
            guardChip.Text="GUARD IDLE"
            guardChip.TextColor3=SUB
        end
    end
    task.spawn(function()
        while not unloaded do
            pcall(updateHUD)
            task.wait(0.25)
        end
    end)
    relayout()
    refreshUI()
    syncAnti()
end
local okUI,errUI=pcall(buildUI)
if not okUI then warn("[STP] UI error: "..tostring(errUI)) end
