        local mn,mx=boundsOf(lob)
        if mn then return Vector3.new((mn.X+mx.X)/2,mx.Y+4,(mn.Z+mx.Z)/2) end
    end
    local sp=Workspace:FindFirstChildWhichIsA("SpawnLocation",true)
    if sp then return standPos(sp) end
end
