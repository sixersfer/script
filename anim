local function new(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            parent = v
        else
            o[k] = v
        end
    end
    for _, c in ipairs(children or {}) do
        c.Parent = o
    end
    if parent then
        o.Parent = parent
    end
    return o
end

local function with(defaults, props)
    local t = {}
    for k, v in pairs(defaults) do
        t[k] = v
    end
    for k, v in pairs(props or {}) do
        t[k] = v
    end
    return t
end

