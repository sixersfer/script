local requestFn = (syn and syn.request) or request or http_request or (http and http.request)

local function httpGet(url)
    if requestFn then
        local ok, res = pcall(requestFn, {Url = url, Method = "GET"})
        if ok and res and res.Body and (res.StatusCode == nil or res.StatusCode == 200) then
            return res.Body
        end
    end
    local ok, body = pcall(function()
        return game:HttpGet(url)
    end)
    if ok then
        return body
    end
end

local function apiJson(sub, path)
    for _, dom in ipairs({"roblox.com", "roproxy.com"}) do
        local body = httpGet("https://" .. sub .. "." .. dom .. path)
        if body then
            local ok, d = pcall(function()
                return HttpService:JSONDecode(body)
            end)
            if ok and type(d) == "table" and d.errors == nil then
                return d
            end
        end
    end
end

local function catalogJson(path)
