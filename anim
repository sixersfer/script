local function loadStore()
    if not canFile then
        return
    end
    local ok, raw = pcall(function()
        if isfile(CFG.SAVE_FILE) then
            return readfile(CFG.SAVE_FILE)
        end
    end)
    if not ok or type(raw) ~= "string" then
        return
    end
    local ok2, d = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok2 or type(d) ~= "table" then
        return
    end
    if type(d.pages) == "table" then
        local pgs = {}
        for i, pg in ipairs(d.pages) do
            if i > CFG.MAX_PAGES then
                break
            end
            local p = {}
            if type(pg) == "table" then
                for k, e in pairs(pg) do
                    local n = tonumber(k)
                    if n and n >= 1 and n <= CFG.SLOTS and type(e) == "table" and e.id then
                        p[n] = {id = idStr(e.id), name = tostring(e.name or e.id), direct = e.direct == true}
                    end
                end
            end
            pgs[i] = p
        end
        if #pgs > 0 then
            store.pages = pgs
        end
    end
    if type(d.loadout) == "table" then
        store.loadout = readLoadout(d.loadout)
    end
    if type(d.presets) == "table" then
        for i, p in ipairs(d.presets) do
            if i > CFG.MAX_PRESETS then
                break
            end
            if type(p) == "table" and type(p.name) == "string" and p.name ~= "" then
                store.presets[#store.presets + 1] = {name = p.name, loadout = readLoadout(p.loadout)}
            end
        end
    end
    for _, k in ipairs({"auto", "enforce", "closeOnPlay", "stopOnMove", "loop"}) do
        if type(d[k]) == "boolean" then
            store[k] = d[k]
        end
    end
    if tonumber(d.speed) then
        store.speed = math.clamp(tonumber(d.speed), 0.25, 3)
    end
    if type(d.keys) == "table" then
        for k in pairs(DEFAULT_KEYS) do
            if type(d.keys[k]) == "string" and keyFromName(d.keys[k]) then
                store.keys[k] = d.keys[k]
            end
        end
    end
    if type(d.win) == "table" and tonumber(d.win.x) and tonumber(d.win.y) and tonumber(d.win.w) and tonumber(d.win.h) then
        store.win = {x = d.win.x, y = d.win.y, w = d.win.w, h = d.win.h}
    end
    if type(d.tab) == "string" then
        store.tab = d.tab
    end
    store.page = math.clamp(tonumber(d.page) or 1, 1, #store.pages)
    store.slot = math.clamp(tonumber(d.slot) or 1, 1, CFG.SLOTS)
end

loadStore()

