bind(UserInputService.InputChanged, function(input)
    local t = input.UserInputType
    if t ~= Enum.UserInputType.MouseMovement and t ~= Enum.UserInputType.Touch then
        return
    end
    if dragState then
        local d = input.Position - dragState.start
        local s = dragState
        if s.mode == "move" then
            win.x = s.x + d.X
            win.y = s.y + d.Y
            applyWin()
        else
            local e = s.edges
            local mw, mh = minSize()
            local nx, ny, nw, nh = s.x, s.y, s.w, s.h
            if e.r then
                nw = math.max(mw, s.w + d.X)
            end
            if e.b then
                nh = math.max(mh, s.h + d.Y)
            end
            if e.l then
                nw = math.max(mw, s.w - d.X)
                nx = s.x + (s.w - nw)
            end
            if e.t then
                nh = math.max(mh, s.h - d.Y)
                ny = s.y + (s.h - nh)
            end
            win.x, win.y, win.w, win.h = nx, ny, nw, nh
            applyWin()
        end
    elseif pvDrag and pv.model then
        pv.yaw = pv.yaw - input.Delta.X * 0.012
        pv.pitch = math.clamp(pv.pitch - input.Delta.Y * 0.008, -1.2, 1.2)
        updateCamera()
    end
end)

bind(UserInputService.InputEnded, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if dragState then
            local s = dragState
            dragState = nil
            if s.handle then
                s.handle.BackgroundTransparency = 1
