do
    local KEYNUM = {
        [Enum.KeyCode.One] = 1,
        [Enum.KeyCode.Two] = 2,
        [Enum.KeyCode.Three] = 3,
        [Enum.KeyCode.Four] = 4,
        [Enum.KeyCode.Five] = 5,
        [Enum.KeyCode.Six] = 6,
        [Enum.KeyCode.Seven] = 7,
        [Enum.KeyCode.Eight] = 8,
        [Enum.KeyCode.KeypadOne] = 1,
        [Enum.KeyCode.KeypadTwo] = 2,
        [Enum.KeyCode.KeypadThree] = 3,
        [Enum.KeyCode.KeypadFour] = 4,
        [Enum.KeyCode.KeypadFive] = 5,
        [Enum.KeyCode.KeypadSix] = 6,
        [Enum.KeyCode.KeypadSeven] = 7,
        [Enum.KeyCode.KeypadEight] = 8,
    }

    local KEY_LABELS = {}
    for _, d in ipairs(keyDefs) do
        KEY_LABELS[d[1]] = d[2]
    end

    bind(UserInputService.InputBegan, function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        local kc = input.KeyCode
        if listening then
            if kc == Enum.KeyCode.Unknown then
                return
            end
            if kc ~= Enum.KeyCode.Escape then
                local conflict
                for id, name in pairs(store.keys) do
                    if id ~= listening and name == kc.Name then
                        conflict = id
                    end
                end
                if conflict then
                    say(kc.Name .. " is already used for: " .. KEY_LABELS[conflict], C.red)
                else
                    store.keys[listening] = kc.Name
                    save()
                    say("Bound " .. KEY_LABELS[listening] .. " to " .. kc.Name, C.green)
                end
            end
            listening = nil
            refreshKeys()
            return
        end
        if UserInputService:GetFocusedTextBox() then
            return
        end
        local name = kc.Name
        local keys = store.keys
        if name == keys.toggle then
            setVisible(not gui.Enabled)
        elseif name == keys.wheel then
            toggleWheel()
        elseif wheelGui.Enabled then
            if name == keys.prev then
                changePage(-1)
            elseif name == keys.next then
                changePage(1)
            elseif KEYNUM[kc] then
                playWheelSlot(KEYNUM[kc])
            end
        end
    end)
end

local function onCharacter(char)
    task.spawn(function()
        local hum = char:WaitForChild("Humanoid", 10)
        local animate = char:WaitForChild("Animate", 10)
        if not alive or not hum or not animate then
            return
        end
        -- Take the snapshot of the original animations BEFORE the loadout is applied
        captureOriginal(char)
        task.wait(0.6)
        if alive and store.auto and next(store.loadout) and char.Parent then
            applyLoadout()
        end
        task.wait(0.6)
        if alive and char.Parent then
            buildModel()
        end
    end)
end

bind(LP.CharacterAdded, onCharacter)

task.spawn(function()
    while alive do
        task.wait(1.5)
        if store.auto and store.enforce and next(store.loadout) and not applying then
            local char = LP.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local animate = char and char:FindFirstChild("Animate")
            if hum and animate and hum.Health > 0 and hum.RigType == Enum.HumanoidRigType.R15 and not animate.Disabled and needsReapply(animate) then
                applyLoadout()
            end
        end
    end
end)

