-- Sanitizes / deep-copies a loadout table (used for loading from disk and for presets).
local function readLoadout(src)
    local out = {}
    if type(src) == "table" then
        for _, def in ipairs(STATES) do
            local v = src[def.key]
            if type(v) == "table" and type(v.id) == "string" then
                out[def.key] = {
                    id = v.id,
                    id2 = type(v.id2) == "string" and v.id2 or nil,
                    name = tostring(v.name or "Custom"),
                }
            end
        end
    end
    return out
end

local canFile = type(isfile) == "function" and type(readfile) == "function" and type(writefile) == "function"
local saveToken = 0

local function serialize()
    local pgs = {}
    for i, pg in ipairs(store.pages) do
        local o = {}
        for s = 1, CFG.SLOTS do
            local e = pg[s]
            if e then
                o[tostring(s)] = {id = idStr(e.id), name = e.name, direct = e.direct == true}
            end
        end
        pgs[i] = o
    end
    local lo = {}
    for k, v in pairs(store.loadout) do
        lo[k] = {id = v.id, id2 = v.id2, name = v.name}
    end
    local prs = {}
    for i, p in ipairs(store.presets) do
        local plo = {}
        for k, v in pairs(p.loadout) do
            plo[k] = {id = v.id, id2 = v.id2, name = v.name}
        end
        prs[i] = {name = p.name, loadout = plo}
    end
    return {
        version = 4,
        pages = pgs,
        loadout = lo,
        presets = prs,
        page = store.page,
        slot = store.slot,
        tab = store.tab,
        auto = store.auto,
        enforce = store.enforce,
        closeOnPlay = store.closeOnPlay,
        stopOnMove = store.stopOnMove,
        speed = store.speed,
        loop = store.loop,
        keys = store.keys,
        win = store.win,
    }
end

local function saveNow()
    if not canFile then
        return
    end
    pcall(function()
        writefile(CFG.SAVE_FILE, HttpService:JSONEncode(serialize()))
    end)
end

local function save()
    if not canFile then
        return
    end
    saveToken += 1
    local t = saveToken
    task.delay(0.4, function()
        if t ~= saveToken or not alive then
            return
        end
        saveNow()
    end)
end

