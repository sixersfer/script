    local glyph = label({Position = UDim2.new(0.5, -22, 0, 4), Size = UDim2.fromOffset(44, 44), TextSize = 22, Font = Enum.Font.GothamBold, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center, Parent = b})
    local nm = label({Position = UDim2.new(0, 3, 1, -26), Size = UDim2.new(1, -6, 0, 24), TextSize = 10, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, Parent = b})
