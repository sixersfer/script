local function fillSlot(s, e)
    s.name.Text = e and e.name or "Empty"
    s.name.TextColor3 = e and C.cream or C.dim
    if e and not e.direct then
        s.thumb.Image = thumbUrl(e.id)
        s.thumb.Visible = true
        s.glyph.Text = ""
    else
        s.thumb.Image = ""
        s.thumb.Visible = false
        s.glyph.Text = e and string.upper(string.sub(e.name, 1, 1)) or "+"
    end
end

