end

local animCache = {}

local function getAnims(assetId)
    assetId = idStr(assetId)
    if animCache[assetId] then
        return animCache[assetId]
    end
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. assetId)
    end)
    if not ok or type(objs) ~= "table" then
        return nil
    end
    local found = {}
    for _, o in ipairs(objs) do
        if o:IsA("Animation") then
            found[#found + 1] = {name = o.Name, id = o.AnimationId}
        end
        for _, d in ipairs(o:GetDescendants()) do
            if d:IsA("Animation") then
                found[#found + 1] = {name = d.Name, id = d.AnimationId}
            end
        end
        pcall(function()
            o:Destroy()
        end)
    end
    if #found == 0 then
        return nil
    end
    table.sort(found, function(a, b)
        return a.name < b.name
    end)
    local ids = {}
    for _, f in ipairs(found) do
        ids[#ids + 1] = f.id
    end
    animCache[assetId] = ids
    return ids
end

local function resolveEmote(e)
    if e.direct then
        return rid(e.id)
    end
    local ids = getAnims(e.id)
    return ids and ids[1] or rid(e.id)
end

-- Picks the state keyword that appears LAST in the item name,
-- so "Catwalk Glam Jump" is not mistaken for "walk".
local STATE_WORDS = {"idle", "walk", "run", "jump", "fall", "climb"}

local function classify(name)
    local n = name:lower()
    if n:find("swim", 1, true) then
        return n:find("idle", 1, true) and "swimidle" or "swim"
    end
    local best, bestPos
    for _, k in ipairs(STATE_WORDS) do
        local from, pos = 1, nil
        while true do
            local s = n:find(k, from, true)
            if not s then
                break
            end
            pos = s
            from = s + 1
        end
        if pos and (not bestPos or pos > bestPos) then
            best, bestPos = k, pos
        end
    end
    return best
end

local function retry(n, fn)
    for i = 1, n do
        local ok, r = pcall(fn)
        if ok and r then
            return r
        end
        task.wait(0.4 * i)
    end
end

local bundleCache = {}

local function resolveBundle(item)
    if bundleCache[item.id] then
        return bundleCache[item.id]
    end
    local d = retry(3, function()
        return catalogJson("/v1/bundles/" .. item.id .. "/details")
    end)
    if not d then
        return nil, "HTTP failed (rate limit / blocked). Wait a few seconds, then click the bundle again."
    end
    if type(d.items) ~= "table" then
        return nil, "Bundle response has no item list."
    end
    local found, names = {}, {}
    for _, it in ipairs(d.items) do
        if it.type == "Asset" then
            local nm = tostring(it.name or "")
            names[#names + 1] = nm
            local st = classify(nm)
            if st and not found[st] then
                found[st] = idStr(it.id)
            end
        end
    end
    if not next(found) then
        return nil, "Unrecognized item names: " .. table.concat(names, ", ")
    end
    local out, pending = {}, 0
    for st, aid in pairs(found) do
        pending += 1
        task.spawn(function()
            local ids = retry(3, function()
                return getAnims(aid)
            end)
            if ids and ids[1] then
                out[st] = {id = ids[1], id2 = st == "idle" and (ids[2] or ids[1]) or nil}
            end
            pending -= 1
        end)
    end
    local t0 = os.clock()
    while pending > 0 and os.clock() - t0 < 20 do
        task.wait(0.05)
    end
    if not next(out) then
        return nil, "GetObjects failed for every item. Try again, or your executor does not support it."
    end
    bundleCache[item.id] = out
    return out
end

local playing = {}

local function stopEmote()
    if playing.conn then
        playing.conn:Disconnect()
        playing.conn = nil
    end
    local t = playing.track
    playing.track = nil
    if t then
        pcall(function()
            t:Stop(0.2)
        end)
    end
end

local function playEmote(entry)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        say("Your character is not ready", C.red)
        return
    end
    task.spawn(function()
        local animId = resolveEmote(entry)
        stopEmote()
        local animator = hum:FindFirstChildOfClass("Animator") or new("Animator", {Parent = hum})
        local a = new("Animation", {AnimationId = animId})
        local ok, tr = pcall(function()
            return animator:LoadAnimation(a)
        end)
        if not ok or not tr then
            say("Failed to load " .. entry.name, C.red)
            return
        end
        tr.Priority = Enum.AnimationPriority.Action
        tr:Play(0.2)
        playing.track = tr
        if store.stopOnMove then
            playing.conn = RunService.Heartbeat:Connect(function()
                if hum.MoveDirection.Magnitude > 0.1 then
                    stopEmote()
                end
            end)
        end
        tr.Stopped:Connect(function()
            if playing.track == tr then
                stopEmote()
            end
        end)
        say("Playing " .. entry.name, C.green)
    end)
end

local function writeState(animate, def, entry)
    local folder = animate:FindFirstChild(def.folder)
    if not folder then
        return
    end
    for i, childName in ipairs(def.children) do
        local v = folder:FindFirstChild(childName)
        if v and v:IsA("Animation") then
            v.AnimationId = (i == 2 and entry.id2) or entry.id
        end
    end
end

local function needsReapply(animate)
    for key, entry in pairs(store.loadout) do
        local def = STATE_BY_KEY[key]
        local folder = def and animate:FindFirstChild(def.folder)
        local v = folder and folder:FindFirstChild(def.children[1])
        if v and v:IsA("Animation") and numOf(v.AnimationId) ~= numOf(entry.id) then
            return true
        end
    end
    return false
end

-- Snapshot of the character's original animations (taken before any loadout is written).
-- Kept in genv so it survives a re-execute as long as the character is the same.
local origSnap = nil

local function origEntry(key)
    if origSnap and origSnap.char == LP.Character then
        return origSnap.entries[key]
    end
    return nil
end

local function captureOriginal(char)
    local animate = char and char:FindFirstChild("Animate")
    if not animate then
        return
    end
    local cached = genv.__EmoteStudioOrig
    if cached and cached.char == char then
        origSnap = cached
        return
    end
    local entries = {}
    for _, def in ipairs(STATES) do
        local folder = animate:FindFirstChild(def.folder)
        if folder then
            local e = {}
            for i, childName in ipairs(def.children) do
                local v = folder:FindFirstChild(childName)
                if v and v:IsA("Animation") then
                    if i == 1 then
                        e.id = v.AnimationId
                    else
                        e.id2 = v.AnimationId
                    end
                end
            end
            if e.id then
                entries[def.key] = e
            end
        end
    end
    origSnap = {char = char, entries = entries}
    genv.__EmoteStudioOrig = origSnap
end

local function doApply(char, tbl)
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animate = char:FindFirstChild("Animate")
    if not hum or not animate or hum.RigType ~= Enum.HumanoidRigType.R15 then
        return
    end
    animate.Disabled = true
    local animator = hum:FindFirstChildOfClass("Animator")
    if animator then
        for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
            t:Stop(0)
        end
    end
    for _, def in ipairs(STATES) do
        local entry = tbl[def.key]
        if entry then
            writeState(animate, def, entry)
        end
    end
    RunService.Heartbeat:Wait()
    animate.Disabled = false
end

local applying, again, pendingTbl = false, false, nil

local function applyLoadout(override)
    pendingTbl = override or store.loadout
    if applying then
        again = true
        return
    end
    applying = true
    task.spawn(function()
        repeat
            again = false
            local char = LP.Character
            if char then
                pcall(doApply, char, pendingTbl)
            end
        until not again
        applying = false
    end)
end

