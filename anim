                loadBtn.MouseButton1Click:Connect(function()
                    loadPreset(p)
                end)
                confirmClick(delBtn, function()
                    local idx = table.find(store.presets, p)
                    if idx then
                        table.remove(store.presets, idx)
                        save()
                        refreshPresets()
                        say("Preset '" .. p.name .. "' deleted", C.green)
                    end
                end)
            end
        end

        local function savePreset()
            if not next(store.loadout) then
                say("Your loadout is empty. Add some animations first.", C.red)
                return
            end
            local name = nameBox.Text:match("^%s*(.-)%s*$") or ""
            name = name:sub(1, 24)
            if name == "" then
                name = "Preset " .. (#store.presets + 1)
            end
            local existing
            for _, p in ipairs(store.presets) do
                if p.name:lower() == name:lower() then
                    existing = p
                    break
                end
            end
            if existing then
                existing.loadout = readLoadout(store.loadout)
                say("Preset '" .. existing.name .. "' updated", C.green)
            else
                if #store.presets >= CFG.MAX_PRESETS then
                    say("Preset limit reached (" .. CFG.MAX_PRESETS .. "). Delete one first.", C.red)
                    return
                end
                store.presets[#store.presets + 1] = {name = name, loadout = readLoadout(store.loadout)}
                say("Preset '" .. name .. "' saved", C.green)
            end
            nameBox.Text = ""
            save()
            refreshPresets()
        end

        saveBtn.MouseButton1Click:Connect(savePreset)
        nameBox.FocusLost:Connect(function(enter)
            if enter then
                savePreset()
            end
        end)
        closeBtn.MouseButton1Click:Connect(function()
            panel.Visible = false
        end)
        presetBtn.MouseButton1Click:Connect(function()
            panel.Visible = not panel.Visible
            if panel.Visible then
                refreshPresets()
            end
        end)
    end

    ui.refresh()
end

