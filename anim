playPreview = function(animId, looped, isBase)
    if not pv.animator then
        return nil
    end
    stopPreview()
    local a = new("Animation", {AnimationId = animId})
    local ok, tr = pcall(function()
        return pv.animator:LoadAnimation(a)
    end)
    if not ok or not tr then
        return nil
    end
    if looped == nil then
        looped = pv.loop
    end
    if not isBase then
        pv.last = {id = animId, looped = looped}
    end
    tr.Priority = Enum.AnimationPriority.Action4
    tr.Looped = looped
    tr:Play(0.1, 1, pv.speed)
    pv.track = tr
    tr.Stopped:Connect(function()
        if pv.track == tr and alive then
            playBase()
        end
    end)
    return tr
end

buildModel = function()
    stopPreview()
    if pv.model then
        pv.model:Destroy()
        pv.model = nil
    end
    pv.animator = nil
    local char = LP.Character
    if not char then
        say("Waiting for your character...")
        return
    end
    local prev = char.Archivable
    char.Archivable = true
    local ok, clone = pcall(function()
        return char:Clone()
    end)
    char.Archivable = prev
    if not ok or not clone then
        say("Could not clone your character", C.red)
        return
    end
    local hum = clone:FindFirstChildOfClass("Humanoid")
    local root = clone:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        clone:Destroy()
        say("Character has no Humanoid", C.red)
        return
    end
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Sound") or d:IsA("BillboardGui") or d:IsA("ForceField") then
            d:Destroy()
        elseif d:IsA("BasePart") then
            d.Anchored = false
        end
    end
    root.Anchored = true
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    clone:PivotTo(CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi, 0))
    clone.Parent = world
    pv.model = clone
    pv.animator = hum:FindFirstChildOfClass("Animator") or new("Animator", {Parent = hum})
    local cf, size = clone:GetBoundingBox()
    pv.center = cf.Position
    pv.baseDist = math.max(size.Y * 1.6, 6)
    pv.dist = pv.baseDist
    pv.yaw = 0
    pv.pitch = -0.1
    updateCamera()
    playBase()
end

