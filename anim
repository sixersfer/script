local function newSearch()
    return {items = {}, cursor = nil, keyword = "", source = "catalog", page = 1, loading = false, failed = false, exhausted = false, token = 0, sortIdx = 1, started = false, noSub = false}
end

local S = {emotes = newSearch(), anims = newSearch()}
local browseUI = {}
local glowTweens = {}

local function refreshBrowse(kind)
    local u = browseUI[kind]
    if u then
        u.refresh()
    end
end

local function buildPath(sub, st)
    local p = "/v1/search/items/details?Category=" .. CFG.CATEGORY .. "&Limit=30&SortType=" .. SORTS[st.sortIdx][2]
    if sub then
        p = p .. "&Subcategory=" .. sub
    end
    if st.keyword ~= "" then
        p = p .. "&Keyword=" .. HttpService:UrlEncode(st.keyword)
    end
    if st.cursor then
        p = p .. "&cursor=" .. HttpService:UrlEncode(st.cursor)
    end
    return p
end

local function fetchBatch(kind, st)
    local sub = kind == "emotes" and CFG.EMOTE_SUB or CFG.BUNDLE_SUB
    if kind == "anims" and st.noSub then
        sub = nil
    end
    local d = catalogJson(buildPath(sub, st))
    if not d and sub and kind == "anims" then
        st.noSub = true
        d = catalogJson(buildPath(nil, st))
    end
    return d
end

local function lookupId(kind, id)
    if kind == "anims" then
        local d = catalogJson("/v1/bundles/" .. id .. "/details")
        if d and d.id then
            return {id = idStr(d.id), name = tostring(d.name or ("Bundle " .. id)), creator = d.creator and d.creator.name, thumb = thumbUrl(d.id, true)}
        end
        return nil
    end
    local d = apiJson("economy", "/v2/assets/" .. id .. "/details")
    if d and d.AssetId then
        return {id = idStr(d.AssetId), name = tostring(d.Name or id), creator = d.Creator and d.Creator.Name, thumb = thumbUrl(d.AssetId)}
    end
    return {id = id, name = "Asset " .. id, thumb = thumbUrl(id)}
end

local function runSearch(kind, reset)
    local st = S[kind]
    if st.source ~= "catalog" then
        refreshBrowse(kind)
        return
    end
    if reset then
        st.items = {}
        st.cursor = nil
        st.exhausted = false
        st.page = 1
    end
    st.token += 1
    local tok = st.token
    st.loading = true
    st.failed = false
    refreshBrowse(kind)
    task.spawn(function()
        if reset and st.keyword:match("^%d%d%d%d%d+$") then
            local it = lookupId(kind, st.keyword)
            if tok ~= st.token then
                return
            end
            if it then
                st.items = {it}
                st.exhausted = true
                st.loading = false
                refreshBrowse(kind)
                return
            end
        end
        local need = st.page * CFG.PER_PAGE
        local tries = 0
        while #st.items < need and not st.exhausted and tries < 6 do
            tries += 1
            local d = fetchBatch(kind, st)
            if tok ~= st.token then
                return
            end
            if not d or type(d.data) ~= "table" then
                st.exhausted = true
                st.failed = #st.items == 0
                break
            end
            for _, it in ipairs(d.data) do
                local isBundle = it.itemType == "Bundle"
                if (kind == "anims") == isBundle then
                    st.items[#st.items + 1] = {
                        id = idStr(it.id),
                        name = tostring(it.name or "Unknown"),
                        creator = it.creatorName,
                        thumb = thumbUrl(it.id, isBundle),
                    }
                end
            end
            st.cursor = d.nextPageCursor
            if not st.cursor then
                st.exhausted = true
            end
        end
        if tok ~= st.token then
            return
        end
        if st.page > 1 and #st.items <= (st.page - 1) * CFG.PER_PAGE then
            st.page -= 1
        end
        st.loading = false
        refreshBrowse(kind)
    end)
end

local function getList(kind)
    local st = S[kind]
    if st.source == "catalog" then
        return st.items
    end
    local src = kind == "emotes" and BUILTIN or PACK_ITEMS
    local kw = st.keyword:lower()
    if kw == "" then
        return src
    end
    local out = {}
    for _, it in ipairs(src) do
        if it.name:lower():find(kw, 1, true) then
            out[#out + 1] = it
        end
    end
    return out
end

local function findFree(p0, s0)
    local total = #store.pages * CFG.SLOTS
    for k = 1, total do
        local idx = ((p0 - 1) * CFG.SLOTS + (s0 - 1) + k) % total
        local p = math.floor(idx / CFG.SLOTS) + 1
        local s = idx % CFG.SLOTS + 1
        if not store.pages[p][s] then
            return p, s
        end
    end
end

local function addToWheel(item)
    local entry = {id = idStr(item.id), name = item.name, direct = item.direct == true}
    local pi, si = store.page, store.slot
    if store.pages[pi][si] then
        local fp, fs = findFree(pi, si)
        if fp then
            pi, si = fp, fs
        elseif #store.pages < CFG.MAX_PAGES then
            store.pages[#store.pages + 1] = {}
            pi, si = #store.pages, 1
        end
    end
    store.pages[pi][si] = entry
    store.page, store.slot = pi, si
    local np, ns = findFree(pi, si)
    if np then
        store.page, store.slot = np, ns
    end
    save()
    refreshInventory()
    say(string.format("Added %s to page %d, slot %d", item.name, pi, si), C.green)
end

local function afterLoadoutChange(msg)
    save()
    refreshInventory()
    if store.auto then
        applyLoadout()
    end
    say(msg, C.green)
end

local function fitGrid(grid, layout)
    local w = grid.AbsoluteSize.X - 12 - 4
    if w <= 0 then
        return
    end
    local cols = math.max(2, math.floor((w + 6) / 80))
    local cw = math.floor((w - (cols - 1) * 6) / cols)
    layout.CellSize = UDim2.fromOffset(cw, cw + 20)
end

